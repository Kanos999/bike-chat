# Backend environment variables
# Copy this file to backend/.env and edit values.

# Port to listen on (defaults to 3001 if not set)
PORT=3001

# Logging (optional; backend logs are enabled by default)
# Set to 0/false/no/off to disable
REQUEST_LOGS=1
WS_LOGS=1

# Auth mode options (optional)
# 1) Shared token mode
# AUTH_TOKEN=your-shared-token

# 2) Supabase token verification mode
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...

# Optional presence snapshot persistence
# PRESENCE_SNAPSHOT_PATH=/tmp/bikechat-presence.json

# TURN relay (optional; enables cross-cellular voice). See ../turn/README.md.
# TURN_SECRET must equal coturn's static-auth-secret. If unset, clients use STUN only.
# TURN_SECRET=long-random-secret
# TURN_URLS=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp,turns:turn.yourdomain.com:5349?transport=tcp
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_TTL_SECONDS=86400

# LiveKit SFU voice (multi-party > 4 riders). When set, GET /voice-token mints
# room-scoped join tokens; if unset, /voice-token returns 503. See docs/SFU_MIGRATION_PLAN.md.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret
# LIVEKIT_TOKEN_TTL_SECONDS=3600
